    "customization.purchase-help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One purchase unlocks notification and Live Activity templates on your devices. Closing a Live Activity is free for everyone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度の購入で通知とライブアクティビティの表示を変更できます。 × ボタンはすべてのユーザーが無料で使用できます。"
          }
        }
      },
      "comment": "Display customization editor text. Braced field names in templates are literal variable names and must not be translated."
    },
    "customization.restore": {
      "extractionState": "manual",
      "localizations": {
