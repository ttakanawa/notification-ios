    "tags.delete-confirmation.message": {
      "comment": "User-facing text for the semantic key tags.delete-confirmation.message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting this tag removes it from reminders but does not delete any reminder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタグを削除するとリマインダーとの関連付けが解除されますが、リマインダー自体は削除されません。"
          }
        }
      }
    },
    "tags.delete-confirmation.title": {
      "comment": "User-facing text for the semantic key tags.delete-confirmation.title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete This Tag?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタグを削除しますか？"
          }
        }
      }
    },
    "tags.error.duplicate-name": {
      "comment": "User-facing error text announced by VoiceOver and also shown visually.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tag with the same name already exists on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ名前のタグがこの端末にすでにあります。"
          }
        }
      }
    },
    "tags.error.empty-name": {
      "comment": "User-facing error text announced by VoiceOver and also shown visually.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a tag name."
