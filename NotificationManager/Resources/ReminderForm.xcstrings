    "reminder.form.capacity-confirmation.message": {
      "comment": "The app planning capacity. The %lld placeholder is the maximum number of notifications Punctual schedules at once.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Punctual can schedule up to %lld notifications at once, so this reminder’s earliest notification may not be scheduled. Save anyway?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Punctual が一度に予約できる通知は最大%lld件のため、このリマインダーの最初の通知が予約されない可能性があります。このまま保存しますか？"
          }
        }
      }
    },
