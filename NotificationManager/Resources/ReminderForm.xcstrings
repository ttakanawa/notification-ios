{
  "sourceLanguage": "en",
  "strings": {
    "reminder.custom.error.assistance-unavailable": {
      "comment": "User-facing error text announced by VoiceOver and also shown visually.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assisted interpretation is unavailable. Enter a repeat rule or choose a preset."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力支援を利用できません。繰り返しルールを入力するか、プリセットを選択してください。"
          }
        }
      }
    },
    "reminder.custom.error.generation": {
      "comment": "User-facing error text announced by VoiceOver and also shown visually.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The repeat rule could not be interpreted. Revise the text and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返しルールを解釈できませんでした。入力を修正してもう一度お試しください。"
          }
        }
      }
    },
    "reminder.custom.error.unsupported-language-or-locale": {
      "comment": "User-facing error text announced by VoiceOver and also shown visually.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence does not support the language or locale of this input."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence はこの入力の言語または地域に対応していません。"
          }
        }
      }
    },
    "reminder.custom.error.safety": {
      "comment": "User-facing error text announced by VoiceOver and also shown visually.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This repeat rule could not be processed safely. Revise the text and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この繰り返しルールは安全に処理できませんでした。入力を修正してもう一度お試しください。"
          }
        }
      }
    },
    "reminder.custom.error.validation": {
      "comment": "User-facing error text announced by VoiceOver and also shown visually.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The interpreted repeat rule is not valid. Revise the text and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解釈された繰り返しルールが無効です。入力を修正してもう一度お試しください。"
          }
        }
      }
    },
