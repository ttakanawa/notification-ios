    "settings.authorization.ephemeral": {
      "comment": "User-facing text for the semantic key settings.authorization.ephemeral.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ephemeral"
          }
        },
        "ja": {
