    "settings.icloud.explanation": {"comment": "Clarifies that the displayed iCloud status is limited to activity observed on this device and is not a global completion guarantee.", "extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Reminders, tags and display preferences stay on this device when sync is off or you sign out. Turning sync on merges cloud data and keeps recovery versions of conflicting values. Older app versions do not receive changes made by this version."}}, "ja": {"stringUnit": {"state": "translated", "value": "同期をオフにした場合やサインアウトした場合も、 リマインダー、 タグ、 表示設定はこのデバイスに保持されます。 同期をオンにするとクラウドのデータを統合し、 競合した値の復旧用バージョンを保持します。 古いバージョンのアプリには、 このバージョンでの変更は反映されません。"}}}},
    "settings.notifications.explanation": {
      "comment": "User-facing text for the semantic key settings.notifications.explanation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This setting applies only to this device. Turning it off keeps reminders and tags in iCloud and removes app-owned pending notifications from this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定はこの端末だけに適用されます。オフにしてもリマインダーとタグは iCloud に残り、この端末で保留中のアプリ通知を削除します。"
          }
        }
      }
    },
