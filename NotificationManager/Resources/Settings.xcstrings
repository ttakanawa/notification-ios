{
  "sourceLanguage": "en",
  "strings": {
    "settings.icloud.switch": {"comment": "iCloud retention and account consent UI.", "extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Sync with iCloud on this device"}}, "ja": {"stringUnit": {"state": "translated", "value": "このデバイスで iCloud と同期"}}}},
    "settings.icloud.off": {"comment": "iCloud retention and account consent UI.", "extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Off — saved on this device"}}, "ja": {"stringUnit": {"state": "translated", "value": "オフ（このデバイスに保存）"}}}},
    "settings.icloud.confirmation-needed": {"comment": "iCloud retention and account consent UI.", "extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Confirmation needed"}}, "ja": {"stringUnit": {"state": "translated", "value": "確認が必要です"}}}},
    "settings.icloud.retry": {"comment": "iCloud retention and account consent UI.", "extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Check and sync now"}}, "ja": {"stringUnit": {"state": "translated", "value": "確認して同期する"}}}},
    "settings.icloud.recovery": {"comment": "iCloud retention and account consent UI.", "extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Saved recovery versions"}}, "ja": {"stringUnit": {"state": "translated", "value": "保存された復旧用バージョン"}}}},
    "settings.icloud.save-failed": {"comment": "iCloud retention and account consent UI.", "extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Could not save the change. Your retained data is unchanged. Try again."}}, "ja": {"stringUnit": {"state": "translated", "value": "変更を保存できませんでした。 保持されたデータは変更されていません。 もう一度お試しください。"}}}},
    "settings.icloud.deleted-version": {"comment": "iCloud retention and account consent UI.", "extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This version records a deletion. Earlier values remain recoverable."}}, "ja": {"stringUnit": {"state": "translated", "value": "このバージョンは削除を記録しています。 以前の値は復旧できます。"}}}},
    "settings.icloud.restore-version": {"comment": "iCloud retention and account consent UI.", "extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Use this version"}}, "ja": {"stringUnit": {"state": "translated", "value": "このバージョンを使用"}}}},
    "settings.icloud.confirm.title": {"comment": "iCloud retention and account consent UI.", "extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Sync retained data to this Apple Account?"}}, "ja": {"stringUnit": {"state": "translated", "value": "保持されたデータをこの Apple Account と同期しますか？"}}}},
    "settings.icloud.confirm.message": {"comment": "iCloud retention and account consent UI.", "extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This device has retained data from another or unverified account. Continuing uploads reminders, tags, display preferences and recovery versions to the current Apple Account and merges its cloud data. Declining turns off sync on this device until you turn it on again."}}, "ja": {"stringUnit": {"state": "translated", "value": "このデバイスには別のアカウントまたは未確認のアカウント由来のデータがあります。 続行すると、 リマインダー、 タグ、 表示設定、 復旧用バージョンを現在の Apple Account にアップロードし、 クラウドのデータと統合します。 拒否すると、 再びオンにするまでこのデバイスの同期はオフになります。"}}}},
    "settings.icloud.confirm.refuse": {"comment": "iCloud retention and account consent UI.", "extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Keep sync off"}}, "ja": {"stringUnit": {"state": "translated", "value": "同期をオフにする"}}}},
    "settings.icloud.confirm.accept": {"comment": "iCloud retention and account consent UI.", "extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Merge and sync"}}, "ja": {"stringUnit": {"state": "translated", "value": "統合して同期"}}}},
    "settings.alarmkit-trial.refresh-state": {
      "comment": "Refreshes the tracked trial's current state from AlarmKit.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Check alarm state" } },
        "ja": { "stringUnit": { "state": "translated", "value": "アラームの状態を確認" } }
      }
    },
    "settings.alarmkit-trial.phase.scheduled": {
      "comment": "The system reports a scheduled trial alarm.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Alarm is scheduled." } },
        "ja": { "stringUnit": { "state": "translated", "value": "アラームは予約済みです。" } }
      }
    },
    "settings.alarmkit-trial.phase.countdown": {
      "comment": "The system reports an active countdown.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Countdown is running." } },
        "ja": { "stringUnit": { "state": "translated", "value": "カウントダウン中です。" } }
      }
    },
    "settings.alarmkit-trial.phase.paused": {
      "comment": "The system reports a paused countdown.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Countdown is paused." } },
        "ja": { "stringUnit": { "state": "translated", "value": "カウントダウンは一時停止中です。" } }
      }
    },
    "settings.alarmkit-trial.phase.alerting": {
      "comment": "The system reports that the trial alarm is alerting.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The alarm time has arrived." } },
        "ja": { "stringUnit": { "state": "translated", "value": "アラームの時刻になりました。" } }
      }
    },
    "settings.alarmkit-trial.link": {
      "comment": "Navigation link to the opt-in AlarmKit prototype.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Try AlarmKit" } },
        "ja": { "stringUnit": { "state": "translated", "value": "AlarmKit を試す" } }
      }
    },
    "settings.alarmkit-trial.title": {
      "comment": "Title of the AlarmKit prototype screen.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "AlarmKit Trial" } },
        "ja": { "stringUnit": { "state": "translated", "value": "AlarmKit 検証" } }
      }
    },
    "settings.alarmkit-trial.description": {
      "comment": "Explains the OS-managed countdown-to-alert trial.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Start a test countdown, then close the app. At zero, iOS displays your message as an alarm until you stop it." } },
        "ja": { "stringUnit": { "state": "translated", "value": "検証用タイマーを開始してアプリを閉じると、 時刻になったときにメッセージを表示します。 アラーム表示は停止するまで残ります。" } }
      }
    },
    "settings.alarmkit-trial.sound-note": {
      "comment": "Explains the silent-file experiment and the requested no-snooze behavior.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This trial uses a silent audio file and has no snooze. Check the sound and vibration on your device." } },
        "ja": { "stringUnit": { "state": "translated", "value": "無音の音源を使用し、 スヌーズは表示しません。 音や振動の動作を端末で確認してください。" } }
      }
    },
    "settings.alarmkit-trial.default-message": {
      "comment": "Editable initial message for the trial alarm.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "It is time" } },
        "ja": { "stringUnit": { "state": "translated", "value": "通知時刻です" } }
      }
    },
    "settings.alarmkit-trial.message": {
      "comment": "Label of the editable alarm title.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Message to display" } },
        "ja": { "stringUnit": { "state": "translated", "value": "表示するメッセージ" } }
      }
    },
    "settings.alarmkit-trial.duration": {
      "comment": "Duration before the trial alarm fires.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Countdown" } },
        "ja": { "stringUnit": { "state": "translated", "value": "表示までの時間" } }
      }
    },
    "settings.alarmkit-trial.start": {
      "comment": "Starts only the trial timer, requesting alarm permission if needed.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Start test timer" } },
        "ja": { "stringUnit": { "state": "translated", "value": "検証タイマーを開始" } }
      }
    },
    "settings.alarmkit-trial.cancel": {
      "comment": "Cancels only the trial timer.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Stop test timer" } },
        "ja": { "stringUnit": { "state": "translated", "value": "検証タイマーを停止" } }
      }
    },
    "settings.alarmkit-trial.stop": {
      "comment": "Stop label required by the iOS 26.0 alarm presentation.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Stop" } },
        "ja": { "stringUnit": { "state": "translated", "value": "停止" } }
      }
    },
    "settings.alarmkit-trial.status.idle": {
      "comment": "Initial state of the trial timer.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Choose a message and start the test timer." } },
        "ja": { "stringUnit": { "state": "translated", "value": "メッセージと時間を選んで開始してください。" } }
      }
    },
    "settings.alarmkit-trial.status.scheduled": {
      "comment": "Trial alarm scheduled successfully.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Timer scheduled. Close the app to test it." } },
        "ja": { "stringUnit": { "state": "translated", "value": "予約しました。 アプリを閉じて動作を確認できます。" } }
      }
    },
    "settings.alarmkit-trial.status.cancelled": {
      "comment": "Trial alarm was cancelled.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Test timer stopped." } },
        "ja": { "stringUnit": { "state": "translated", "value": "検証タイマーを停止しました。" } }
      }
    },
    "settings.alarmkit-trial.status.denied": {
      "comment": "Alarm permission was not granted.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Alarm permission is required. You can allow it in Settings." } },
        "ja": { "stringUnit": { "state": "translated", "value": "アラームの使用許可が必要です。 設定アプリで許可できます。" } }
      }
    },
    "settings.alarmkit-trial.status.invalid-input": {
      "comment": "Trial alarm input was invalid.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Enter a message and choose a countdown duration." } },
        "ja": { "stringUnit": { "state": "translated", "value": "メッセージと表示までの時間を指定してください。" } }
      }
    },
    "settings.alarmkit-trial.status.failed": {
      "comment": "Trial alarm operation failed.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The test timer could not be changed. Try again." } },
        "ja": { "stringUnit": { "state": "translated", "value": "検証タイマーを変更できませんでした。 もう一度お試しください。" } }
      }
    },
    "privacy.data.foundation-models-on-device": {
      "comment": "Complete About and Privacy disclosure. Keep this limitation explicit and do not shorten it into a guarantee.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assisted repeat interpretation uses only an on-device Foundation Model. It is not sent to Private Cloud Compute or a third-party model provider."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返しの入力支援にはオンデバイスの Foundation Model のみを使用します。Private Cloud Compute や第三者のモデル提供者には送信しません。"
          }
        }
      }
    },
    "privacy.data.no-server-analytics-ads": {
      "comment": "Complete About and Privacy disclosure. Keep this limitation explicit and do not shorten it into a guarantee.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The end notification server receives App Attest verification data, activity push tokens and timing. It receives no reminder titles, notes or templates. This app uses no analytics or advertising SDK. APNs delivery and exact dismissal time are not guaranteed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了通知サーバーに App Attest の検証データ、 ライブアクティビティの配信トークンと時刻を送信します。 タイトル、 メモ、 テンプレートは送信しません。 分析・広告 SDK は使用しません。 APNs の配信と正確な終了時刻は保証されません。"
          }
        }
      }
    },
    "privacy.icloud.account-behavior": {
      "comment": "Complete About and Privacy disclosure. Keep this limitation explicit and do not shorten it into a guarantee.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud account changes and the local copy that remains are managed by the operating system and are not guaranteed by this app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud アカウントの変更と端末に残るローカルコピーは OS が管理し、このアプリでは保証しません。"
          }
        }
      }
    },
    "privacy.icloud.automatic-sync": {
      "comment": "Complete About and Privacy disclosure. Keep this limitation explicit and do not shorten it into a guarantee.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders and tags use SwiftData automatic iCloud sync when the operating system makes it available."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーとタグは、OS が利用可能にしたときに SwiftData の自動 iCloud 同期を使用します。"
          }
        }
      }
    },
    "privacy.icloud.sync-completion": {
      "comment": "Complete About and Privacy disclosure. Keep this limitation explicit and do not shorten it into a guarantee.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app does not show or guarantee upload completion, download completion, timing, or the winner of concurrent edits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリは、アップロードやダウンロードの完了、反映時期、同時編集の結果を表示または保証しません。"
          }
        }
      }
    },
    "privacy.notifications.delayed-operations": {
      "comment": "Complete About and Privacy disclosure. Keep this limitation explicit and do not shorten it into a guarantee.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A notification operation already handed to the operating system can finish after the app terminates, so content may briefly reappear."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OS に渡した通知操作はアプリ終了後に完了することがあり、内容が一時的に再表示される場合があります。"
          }
        }
      }
    },
    "privacy.notifications.delivered-retention": {
      "comment": "Complete About and Privacy disclosure. Keep this limitation explicit and do not shorten it into a guarantee.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivered notifications normally remain under operating-system and user control. Explicit reminder deletion requests best-effort removal only on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信済み通知は通常、OS と利用者が管理します。リマインダーを明示的に削除した場合も、この端末で可能な範囲の削除を要求するだけです。"
          }
        }
      }
    },
    "privacy.notifications.non-atomic-removal": {
      "comment": "Complete About and Privacy disclosure. Keep this limitation explicit and do not shorten it into a guarantee.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing pending or delivered notifications is not atomic with saving, syncing, or delivery, so complete recall cannot be guaranteed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留中または配信済み通知の削除は、保存、同期、配信と一体の処理ではないため、完全な回収は保証できません。"
          }
        }
      }
    },
    "privacy.notifications.os-storage": {
      "comment": "Complete About and Privacy disclosure. Keep this limitation explicit and do not shorten it into a guarantee.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pending and delivered notifications are stored and retained by the operating system outside the app's SwiftData and CloudKit encryption policy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留中および配信済みの通知は、アプリの SwiftData と CloudKit の暗号化方針の対象外で OS に保存・保持されます。"
          }
        }
      }
    },
    "privacy.notifications.previews": {
      "comment": "Complete About and Privacy disclosure. Keep this limitation explicit and do not shorten it into a guarantee.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Titles, notes, and other notification content may appear in previews according to the operating system's notification preview setting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトル、メモなどの通知内容は、OS の通知プレビュー設定に従って表示される場合があります。"
          }
        }
      }
    },
    "privacy.notifications.stale-content": {
      "comment": "Complete About and Privacy disclosure. Keep this limitation explicit and do not shorten it into a guarantee.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "During sync delays, a notification can show an older title, note, recurrence summary, source time, time zone, or reason from this device's previous local snapshot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期の遅延中は、この端末の以前のローカル状態にある古いタイトル、メモ、繰り返し概要、基準時刻、タイムゾーン、理由が通知に表示される場合があります。"
          }
        }
      }
    },
    "privacy.notifications.stale-repeating": {
      "comment": "Complete About and Privacy disclosure. Keep this limitation explicit and do not shorten it into a guarantee.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a crash or termination, a delayed repeating request can repeat stale content until the next time the app runs reconciliation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラッシュや終了後、遅延した繰り返し通知が、次回アプリで再調整されるまで古い内容を繰り返す場合があります。"
          }
        }
      }
    },
    "privacy.section.data": {
      "comment": "Complete About and Privacy disclosure. Keep this limitation explicit and do not shorten it into a guarantee.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data Use"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データの利用"
          }
        }
      }
    },
    "privacy.section.icloud": {
      "comment": "Complete About and Privacy disclosure. Keep this limitation explicit and do not shorten it into a guarantee.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud"
          }
        }
      }
    },
    "privacy.section.notifications": {
      "comment": "Complete About and Privacy disclosure. Keep this limitation explicit and do not shorten it into a guarantee.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知"
          }
        }
      }
    },
    "privacy.title": {
      "comment": "Complete About and Privacy disclosure. Keep this limitation explicit and do not shorten it into a guarantee.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About & Privacy"
          }
        },
        "ja": {
