    "settings.error.authorization-request": {
      "comment": "User-facing error text announced by VoiceOver and also shown visually.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification permission could not be requested. Your device preference was kept."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知許可を要求できませんでした。この端末の設定は保持されています。"
          }
        }
      }
    },
    "settings.error.pending-cleanup": {
      "comment": "User-facing error text announced by VoiceOver and also shown visually.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pending app notifications could not all be removed. Try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留中のアプリ通知をすべて削除できませんでした。もう一度お試しください。"
          }
        }
      }
    },
    "settings.notifications.explanation": {
      "comment": "User-facing text for the semantic key settings.notifications.explanation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This setting applies only to this device. Turning it off keeps reminders and tags in iCloud and removes app-owned pending notifications from this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定はこの端末だけに適用されます。オフにしてもリマインダーとタグは iCloud に残り、この端末で保留中のアプリ通知を削除します。"
          }
        }
      }
    },
    "settings.notifications.this-device": {
      "comment": "User-facing text for the semantic key settings.notifications.this-device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications on This Device"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末で通知"
          }
        }
      }
    },
