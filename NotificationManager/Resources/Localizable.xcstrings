        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app does not show or guarantee upload completion, download completion, timing, or the winner of concurrent edits."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリは、アップロードやダウンロードの完了、反映時期、同時編集の結果を表示または保証しません。"
          }
        }
      }
    },
    "privacy.notifications.delayed-operations" : {
      "comment" : "Complete About and Privacy disclosure. Keep this limitation explicit and do not shorten it into a guarantee.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A notification operation already handed to the operating system can finish after the app terminates, so content may briefly reappear."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OS に渡した通知操作はアプリ終了後に完了することがあり、内容が一時的に再表示される場合があります。"
          }
        }
      }
    },
    "privacy.notifications.delivered-retention" : {
      "comment" : "Complete About and Privacy disclosure. Keep this limitation explicit and do not shorten it into a guarantee.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delivered notifications normally remain under operating-system and user control. Explicit reminder deletion requests best-effort removal only on this device."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配信済み通知は通常、OS と利用者が管理します。リマインダーを明示的に削除した場合も、この端末で可能な範囲の削除を要求するだけです。"
          }
        }
      }
    },
    "privacy.notifications.non-atomic-removal" : {
      "comment" : "Complete About and Privacy disclosure. Keep this limitation explicit and do not shorten it into a guarantee.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removing pending or delivered notifications is not atomic with saving, syncing, or delivery, so complete recall cannot be guaranteed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留中または配信済み通知の削除は、保存、同期、配信と一体の処理ではないため、完全な回収は保証できません。"
          }
        }
      }
    },
    "privacy.notifications.os-storage" : {
      "comment" : "Complete About and Privacy disclosure. Keep this limitation explicit and do not shorten it into a guarantee.",
