{
  "sourceLanguage": "en",
  "strings": {
    "localization.notification.body": {
      "comment": "Notification body template. Placeholder 1 is the user note or localized repeat summary String; placeholder 2 is the localized source-time sentence String; placeholder 3 is the localized reason sentence String.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n%2$@\n%3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n%2$@\n%3$@"
          }
        }
      }
    },
    "localization.reason.one-shot.early.primary": {
      "comment": "Complete notification-reason sentence. The %@ placeholder is a locale-formatted source-zone date and time String.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Early reminder for %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の早期通知です。"
          }
        }
      }
    },
